<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only. Passwords and API tokens must never travel in clear
     text; a tenant or control server on plain http:// fails to connect. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
