<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain http:// so a local bench can be used
     during development. Release builds use src/main (HTTPS only). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
